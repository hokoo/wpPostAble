# Docker Compose project scope. Changing this creates an independent stack.
COMPOSE_PROJECT_NAME=wppostable

# Local WordPress URL.
WP_HOST=wppostable.local
WP_BIND_ADDRESS=127.0.0.1
WP_HTTP_PORT=8089
WP_DEBUG=1
WP_TITLE="wpPostAble Local"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@wppostable.local

# Multi-architecture images for WSL2, Linux, and Apple Silicon/Intel macOS.
NGINX_IMAGE=nginx:1.31.5-alpine
PHP_BASE_IMAGE=wodby/wordpress-php:8.4-4.80.9
MYSQL_IMAGE=mysql:8.0.46
PHP_EXTENSIONS_DISABLE=xdebug,xhprof,spx

# Bound Docker json-file logs. PHP application logs use the php-logs volume.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Credentials for the disposable local-development database only.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-local
DB_ROOT_PASSWORD=wordpress-root-local
